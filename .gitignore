# Secrets: copy .env to other machines by hand
.env

# Python environments (rebuild from requirements files)
.venv/
workspace/.venv/
workspace/.venv-tabpfn/
__pycache__/

# Data: raw downloads (~870 MB, copy separately) and processed tables (regenerated by scripts)
workspace/data/*
# ...except the forward pick ledger and the daily injury overrides, which are the paper-trading record
!workspace/data/ledger/
!workspace/data/overrides/

# Large intermediate results regenerated by the pipeline; small summaries and bet lists are kept
workspace/results/bp_eval_*.parquet
workspace/results/bp_pairs_cache.parquet
workspace/results/bp_dist_*.parquet
workspace/results/dev_preds_*.parquet
workspace/results/review_proxy_all*.parquet
*.bak

.DS_Store
